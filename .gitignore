node_modules/
.env
*.log
*.tmp

# Videos are private by default: each lives in videos/<id>/ and renders to out/<id>/, and neither is committed.
# The two public examples (the OpenClaw explainer and the getting-started tour) are committed, sources and render.
videos/*
!videos/openclaw/
!videos/getting-started/
out/*
!out/openclaw/
out/openclaw/*
!out/openclaw/openclaw-v2.*
!out/getting-started/
out/getting-started/*
!out/getting-started/getting-started-v2.*
videos/openclaw/audio/placeholder-*
# Every render saves its sources here; they are per-machine history, never committed.
videos/*/versions/

# Series looks carry client brands, so they stay local too. The demo series is the one public example.
series/*
!series/demo/

# Local only
notes/
.backup/
