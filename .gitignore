node_modules/
.env
*.log
*.tmp

# Videos are private by default: each lives in videos/<id>/ and renders to out/<id>/, and neither is committed.
# The two public examples (the OpenClaw explainer and the getting-started tour) are committed, sources and render.
videos/*
!videos/openclaw/
!videos/getting-started/
out/*
!out/openclaw/
out/openclaw/*
!out/openclaw/openclaw-v2.*
!out/getting-started/
out/getting-started/*
!out/getting-started/getting-started-v2.*
videos/openclaw/audio/placeholder-*

# Local only
notes/
.backup/
